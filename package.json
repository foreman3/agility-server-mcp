{
  "name": "agility-wincred-mcp",
  "version": "0.3.0",
  "description": "Digital.ai Agility (VersionOne) MCP server with Windows Credential Manager authentication",
  "type": "module",
  "bin": {
    "agility-mcp": "bin/agility-mcp.js"
  },
  "exports": {
    ".": "./src/server.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/credential-manager.ps1",
    "agility.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node bin/agility-mcp.js serve",
    "test": "node --test",
    "test:windows": "node integration/windows-credentials.js",
    "test:live": "node integration/live-tenant.js",
    "check": "node scripts/check.js"
  },
  "keywords": [
    "mcp",
    "digital.ai",
    "agility",
    "versionone",
    "windows",
    "credential-manager"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "fast-xml-parser": "5.11.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1"
  }
}
